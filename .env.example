# Required for scoring
ANTHROPIC_API_KEY=
# Required. The scoring model. Never hardcode it in code.
ANTHROPIC_MODEL=
# Days after an interaction during which a return about the same goal counts as a detractor.
RETURN_WINDOW_DAYS=7
# Optional per-business-line overrides, e.g. billing=14,tech_support=5
RETURN_WINDOW_DAYS_BY_LINE=
# Max parallel scoring requests to the Anthropic API.
SCORING_CONCURRENCY=5
# Optional scorer effort: low | medium | high | xhigh | max. Unset = the model's default.
SCORING_EFFORT=
# Optional. SQLite path, relative to the repo root.
NRS_DB_PATH=data/nrs.db
